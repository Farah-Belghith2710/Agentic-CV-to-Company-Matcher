# Copy this file to .env (same folder) and edit. Everything is optional:
# with no LLM configured the app runs in offline mode (rule-based, no API key needed).

# --- LLM: any OpenAI-compatible endpoint ---------------------------------------------
# Pick ONE block, uncomment it, and paste your key. Model names change often: check the
# provider's model list if you get a "model not found" error.

# Google Gemini (free tier available): key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.8-flash

# Groq (free tier available): key from https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=openai/gpt-oss-20b
# LLM_MODEL_STRONG=openai/gpt-oss-120b

# OpenAI (paid)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-nano
# LLM_MODEL_STRONG=gpt-5.4-mini

# Ollama (free, runs on your computer: https://ollama.com, then `ollama pull qwen3:8b`)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# Stronger model used only for rewriting bullets (defaults to LLM_MODEL)
# LLM_MODEL_STRONG=

# Free tiers limit requests per minute. Set this to stay under the limit (0 = no limit).
LLM_MAX_RPM=0
# Parallel LLM calls (lower it if you hit rate limits)
LLM_CONCURRENCY=4
# Set to true to ignore the LLM settings above and use offline rules
FORCE_OFFLINE=false

# --- Retrieval ---------------------------------------------------------------------------
# auto = multilingual embedding model via fastembed (downloads ~220 MB on first use),
# falling back to TF-IDF if it cannot load. tfidf = never download anything.
EMBEDDINGS=auto
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Data & cache --------------------------------------------------------------------------
# Job snapshot used by the "Demo snapshot" source (see scripts/save_snapshot.py to save real postings)
SNAPSHOT_PATH=data/demo_jobs.json
CACHE_ENABLED=true
CACHE_DIR=.cache

# --- Pipeline knobs --------------------------------------------------------------------------
SHORTLIST_SIZE=12
MIN_RELEVANT=15
MAX_REFINEMENTS=2
MAX_REWRITE_ATTEMPTS=3
BULLETS_PER_JOB=3
